{
    "name": "vue-laravel-crud",
    "version": "3.0.6",
    "type": "module",
    "description": "",
    "homepage": "https://github.com/clonixdev/vue-laravel-crud",
    "main": "dist/vue-laravel-crud.ssr.js",
    "browser": "dist/vue-laravel-crud.esm.js",
    "module": "dist/vue-laravel-crud.esm.js",
    "unpkg": "dist/vue-laravel-crud.min.js",
    "exports": {
        ".": {
            "import": "./src/entry.esm.js",
            "require": "./dist/vue-laravel-crud.ssr.js",
            "default": "./src/entry.esm.js"
        },
        "./UsersCrud": "./src/components/UsersCrud.vue",
        "./RolesCrud": "./src/components/RolesCrud.vue",
        "./PermissionTreeEditor": "./src/components/PermissionTreeEditor.vue",
        "./crudRoutes": "./src/mixins/crudUrlSync.js",
        "./src/*": "./src/*"
    },
    "files": [
        "dist/*",
        "src/**/*"
    ],
    "sideEffects": false,
    "scripts": {
        "serve": "vite dev dev --config vite.config.js",
        "demo": "concurrently \"npm run demo:api\" \"npm run demo:app\"",
        "demo:api": "node dev/api/mockServer.js",
        "demo:app": "vite dev dev/demo --config vite.config.js",
        "build": "node ./node_modules/rollup/dist/bin/rollup --config build/rollup.config.js",
        "build:ssr": "node ./node_modules/rollup/dist/bin/rollup --config build/rollup.config.js --format cjs",
        "build:es": "node ./node_modules/rollup/dist/bin/rollup --config build/rollup.config.js --format es",
        "build:unpkg": "node ./node_modules/rollup/dist/bin/rollup --config build/rollup.config.js --format iife",
        "build:demo": "vite build dev/demo -m production --config vite.config.js",
        "build:gh-pages": "npm run build:demo"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "dayjs": "^1.11.23",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@rollup/plugin-alias": "^6.0.0",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/compiler-sfc": "^3.5.43",
        "bootstrap": "^4.6.2",
        "bootstrap-icons": "^1.13.1",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "express": "^4.22.3",
        "marked": "^18.0.14",
        "minimist": "^1.2.8",
        "rollup": "^4.63.5",
        "rollup-plugin-polyfill-node": "^0.13.0",
        "rollup-plugin-postcss": "^4.0.2",
        "sass": "^1.105.0",
        "vite": "^8.3.1",
        "vue": "^3.5.43",
        "vuex": "^4.1.0"
    },
    "peerDependencies": {
        "@vuex-orm/core": "^0.36.4",
        "@vuex-orm/plugin-axios": "^0.9.4",
        "bootstrap": "^4.6.2 || ^5.0.0",
        "bootstrap-icons": "^1.0.0",
        "vue": "^3.5.0",
        "vuex": "^4.1.0"
    },
    "peerDependenciesMeta": {
        "@vuex-orm/core": {
            "optional": true
        },
        "@vuex-orm/plugin-axios": {
            "optional": true
        },
        "bootstrap": {
            "optional": true
        },
        "bootstrap-icons": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.0.0"
    },
    "overrides": {
        "vue": "^3.5.43"
    }
}
